{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["server.js", "engine/**/*.js", "lib/**/*.js", "api/**/*.js"],
  "exclude": ["node_modules", "dist", "data", "data.bak", "public", "tests"]
}
